{
  "name": "al-abdeen-management",
  "version": "0.1.0",
  "description": "Offline Arabic shop management for mobile and satellite retail",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:linux": "electron-builder --linux AppImage",
    "test": "node tests/accounting.test.cjs",
    "build:android": "npx cap sync android"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12",
    "@capacitor/cli": "^7.4.3"
  },
  "build": {
    "appId": "com.eedabdeen.management",
    "productName": "آل عابدين للإدارة الشاملة",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Al-Abdeen-Management-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@capacitor/android": "^7.4.3"
  }
}
